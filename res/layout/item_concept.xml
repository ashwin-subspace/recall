<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/card"
    android:padding="18dp" android:layout_marginBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/cName" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="15sp"
            android:textStyle="bold" android:textColor="@color/text"/>
        <TextView android:id="@+id/cPct" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textColor="@color/muted"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="6dp"
        android:background="@drawable/bar_track" android:layout_marginTop="10dp">
        <View android:id="@+id/cBar" android:layout_width="0dp"
            android:layout_height="match_parent" android:background="@drawable/bar_fill"/>
    </FrameLayout>
    <TextView android:id="@+id/cMeta" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="11sp"
        android:textColor="@color/faint" android:paddingTop="9dp"/>
    <TextView android:id="@+id/cGaps" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="13sp"
        android:textColor="@color/warm" android:lineSpacingExtra="3dp"
        android:paddingTop="9dp" android:visibility="gone"/>
</LinearLayout>
